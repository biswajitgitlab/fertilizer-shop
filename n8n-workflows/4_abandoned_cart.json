{
  "name": "WORKFLOW 4: Abandoned Cart",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [ { "field": "hours", "hoursInterval": 2 } ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/cart/abandoned",
        "options": {}
      },
      "name": "Get Abandoned Carts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {},
      "name": "Item Lists / Loop",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [ 650, 300 ]
    },
    {
      "parameters": {
        "message": "You left something in your cart! Use code DISCOUNT5 for 5% off. Buy now: LINK"
      },
      "name": "Send Reminder (WhatsApp)",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [ 850, 300 ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [ { "node": "Get Abandoned Carts", "type": "main", "index": 0 } ]
      ]
    },
    "Get Abandoned Carts": {
      "main": [
        [ { "node": "Item Lists / Loop", "type": "main", "index": 0 } ]
      ]
    },
    "Item Lists / Loop": {
      "main": [
        [ { "node": "Send Reminder (WhatsApp)", "type": "main", "index": 0 } ]
      ]
    }
  }
}
