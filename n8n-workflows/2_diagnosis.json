{
  "name": "WORKFLOW 2: AI Diagnosis",
  "nodes": [
    {
      "parameters": {
        "path": "diagnosis-webhook",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "model": "gpt-4-vision-preview",
        "systemMessage": "Analyze these crop images and symptoms. Identify the problem (disease/pests/nutrient deficiency). \nSuggest specific fertilizers. Return JSON with: diagnosis, confidence(0-100), severity, description, causes[], recommended_products[], preventive_measures[]",
        "options": {}
      },
      "name": "OpenAI Vision Node",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json.response || '{}';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(response);\n} catch(e) {}\nreturn { json: parsed };"
      },
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [ 650, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/webhooks/n8n/diagnosis-result",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "diagnosis_id", "value": "={{$node[\"Webhook\"].json[\"body\"][\"diagnosis_id\"]}}" },
            { "name": "ai_result", "value": "={{$json[\"diagnosis\"]}}" },
            { "name": "confidence", "value": "={{$json[\"confidence\"]}}" },
            { "name": "severity", "value": "={{$json[\"severity\"]}}" }
          ]
        },
        "options": {}
      },
      "name": "Update Laravel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 850, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            { "value1": "={{$node[\"Parse JSON\"].json[\"confidence\"]}}", "operation": "smaller", "value2": 60 }
          ]
        }
      },
      "name": "If Low Confidence",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 1050, 300 ]
    },
    {
      "parameters": {
        "fromEmail": "system@fertilizershop.com",
        "toEmail": "admin@fertilizershop.com",
        "subject": "Manual Review Needed for Diagnosis",
        "text": "Confidence is below 60%. Please review diagnosis ID."
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [ 1250, 200 ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [ { "node": "OpenAI Vision Node", "type": "main", "index": 0 } ]
      ]
    },
    "OpenAI Vision Node": {
      "main": [
        [ { "node": "Parse JSON", "type": "main", "index": 0 } ]
      ]
    },
    "Parse JSON": {
      "main": [
        [ { "node": "Update Laravel", "type": "main", "index": 0 } ]
      ]
    },
    "Update Laravel": {
      "main": [
        [ { "node": "If Low Confidence", "type": "main", "index": 0 } ]
      ]
    },
    "If Low Confidence": {
      "main": [
        [ { "node": "Send Email", "type": "main", "index": 0 } ]
      ]
    }
  }
}
