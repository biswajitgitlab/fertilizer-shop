{
  "name": "WORKFLOW 5: Fertilizer Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8 * * *" }
          ]
        }
      },
      "name": "Schedule (8 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/planner/upcoming-tasks",
        "options": {}
      },
      "name": "Get Upcoming Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {},
      "name": "Item Lists / Loop",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [ 650, 300 ]
    },
    {
      "parameters": {
        "message": "Reminder: Apply {{$json[\"recommended_products\"]}} to your {{$json[\"crop_plan\"][\"crop_name\"]}} today. Buy now: LINK"
      },
      "name": "Send Task Reminder",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [ 850, 300 ]
    }
  ],
  "connections": {
    "Schedule (8 AM)": {
      "main": [
        [ { "node": "Get Upcoming Tasks", "type": "main", "index": 0 } ]
      ]
    },
    "Get Upcoming Tasks": {
      "main": [
        [ { "node": "Item Lists / Loop", "type": "main", "index": 0 } ]
      ]
    },
    "Item Lists / Loop": {
      "main": [
        [ { "node": "Send Task Reminder", "type": "main", "index": 0 } ]
      ]
    }
  }
}
